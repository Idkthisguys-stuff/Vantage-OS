CC = aarch64-linux-gnu-gcc
LD = aarch64-linux-gnu-ld
OBJCOPY = aarch64-linux-gnu-objcopy

BUILD_DIR = out
V3D ?= 0
WIFI ?= 0
ifneq ($(filter-out 0 1,$(V3D) $(WIFI)),)
$(error V3D and WIFI must be 0 or 1)
endif
ifeq ($(WIFI),1)
ifeq ($(WIFI_FIRMWARE_C),)
$(error WIFI=1 requires WIFI_FIRMWARE_C generated by tools/embed_wifi.py)
endif
endif

C_SOURCES = $(wildcard init/*.c) \
            $(wildcard kernel/*.c) \
            $(wildcard kernel/sched/*.c) \
            kernel/fs/files.c kernel/fs/file_syscall.c \
            $(wildcard kernel/sched/delays/*.c) \
            $(wildcard arch/armv8/*.c) \
            $(wildcard mm/*.c) \
            $(wildcard drivers/*/*.c) \
			$(wildcard drivers/*.c) \
            $(wildcard user/lib/*.c) \
            $(wildcard user/env/*.c)

S_SOURCES = $(wildcard arch/armv8/*.s)

OBJECTS = $(patsubst %.c, $(BUILD_DIR)/%.o, $(C_SOURCES))
OBJECTS += $(patsubst %.s, $(BUILD_DIR)/%.o, $(S_SOURCES))
MM_OBJECTS = $(patsubst %.c, $(BUILD_DIR)/%.o, $(wildcard mm/*.c))

CFLAGS = -Wall -O2 -ffreestanding -nostdinc -Iinclude -Iuser/include
# Firmware discovery runs with the MMU off: unaligned Device accesses can fault.
CFLAGS += -mstrict-align -MMD -MP
CFLAGS += -Iincludes -DVANTAGE_V3D=$(V3D) -DVANTAGE_WIFI=$(WIFI)
$(MM_OBJECTS): CFLAGS += -Wextra -Werror
$(BUILD_DIR)/kernel/memory.o: CFLAGS += -fno-tree-loop-distribute-patterns
$(patsubst %.c, $(BUILD_DIR)/%.o, $(wildcard kernel/sched/*.c) arch/armv8/task_port.c): CFLAGS += -Wextra -Werror
$(BUILD_DIR)/kernel/fs/files.o $(BUILD_DIR)/kernel/fs/file_syscall.o: CFLAGS += -Wextra -Werror
$(patsubst %.c, $(BUILD_DIR)/%.o, $(wildcard drivers/hw/*.c) $(wildcard drivers/wifi/*.c) drivers/video/v3d.c): CFLAGS += -Wextra -Werror

all: $(BUILD_DIR)/prod/kernel8.img

ifeq ($(WIFI),1)
OBJECTS += $(BUILD_DIR)/drivers/wifi/assets.o
$(BUILD_DIR)/drivers/wifi/assets.o: $(WIFI_FIRMWARE_C)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@
endif

$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/%.o: %.s
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/prod/kernel8.img: $(OBJECTS) arch/armv8/linker.ld
	$(LD) -T arch/armv8/linker.ld $(OBJECTS) -o $(BUILD_DIR)/kernel8.elf
	@mkdir -p $(dir $@)
	$(OBJCOPY) -O binary $(BUILD_DIR)/kernel8.elf $@

clean:
	rm -rf $(BUILD_DIR)

-include $(OBJECTS:.o=.d)
