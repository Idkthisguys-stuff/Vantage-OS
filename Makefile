CC = aarch64-linux-gnu-gcc
LD = aarch64-linux-gnu-ld
OBJCOPY = aarch64-linux-gnu-objcopy

BUILD_DIR ?= out
.DEFAULT_GOAL := all
PYTHON ?= python

include mk/config.mk
include mk/sources.mk

OBJECTS := $(patsubst %.c,$(BUILD_DIR)/%.o,$(C_SOURCES))
OBJECTS += $(patsubst %.s,$(BUILD_DIR)/%.o,$(S_SOURCES))
# The user program brings its own copy of the freestanding memory routines.
USER_OBJECTS := $(patsubst %.s,$(BUILD_DIR)/%.o,$(USER_ASM_SOURCES))
USER_OBJECTS += $(patsubst %.c,$(BUILD_DIR)/%.o,$(USER_SOURCES)) $(BUILD_DIR)/lib/memory.o
# TLS: BearSSL, and trust anchors generated by tools/fetch_ca.py (TLS_TRUST_C)
# or none. BearSSL is configured only by these flags; see docs/TLS.md.
TLS_TRUST_C ?=
BEARSSL_OBJECTS := $(patsubst %.c,$(BUILD_DIR)/%.o,$(BEARSSL_SOURCES))
USER_OBJECTS += $(BEARSSL_OBJECTS) $(BUILD_DIR)/user/tls_trust.o
TLS_OBJECTS := $(BEARSSL_OBJECTS) $(BUILD_DIR)/user/tls_trust.o $(BUILD_DIR)/user/lib/tls.o
BEARSSL_CPPFLAGS := -Ithird_party/bearssl/inc -isystem user/lib/libc -DBR_64=1 -DBR_INT128=1 \
    -DBR_USE_URANDOM=0 -DBR_USE_GETENTROPY=0 -DBR_USE_WIN32_RAND=0 -DBR_RDRAND=0 \
    -DBR_USE_UNIX_TIME=0 -DBR_USE_WIN32_TIME=0 -DBR_AES_X86NI=0 -DBR_SSE2=0 -DBR_POWER8=0

CFLAGS = -Wall -O2 -ffreestanding -nostdinc
# Firmware discovery runs with the MMU off: unaligned Device accesses can fault.
CFLAGS += -mstrict-align -MMD -MP
BUILD_CONFIG_FLAGS := $(CPPFLAGS) $(CFLAGS)
STRICT_SOURCES := $(MEMORY_SOURCES) $(FILESYSTEM_SOURCES) $(NETWORK_SOURCES) $(SCHEDULER_SOURCES) \
    $(DRIVER_SOURCES) platform/pi4/ethernet.c platform/pi4/hardware.c platform/pi4/net.c platform/pi4/startup.c \
    platform/pi4/sd.c platform/pi4/storage.c arch/armv8/task_port.c \
    arch/armv8/irq.c arch/armv8/trap.c arch/armv8/address_space.c \
    kernel/boot/main.c kernel/syscall/dispatch.c kernel/ui/render.c
$(patsubst %.c,$(BUILD_DIR)/%.o,$(STRICT_SOURCES)): CFLAGS += -Wextra -Werror
$(TLS_OBJECTS): CPPFLAGS += $(BEARSSL_CPPFLAGS)
$(BEARSSL_OBJECTS): CPPFLAGS += -Ithird_party/bearssl/src
$(BUILD_DIR)/user/lib/tls.o $(BUILD_DIR)/user/tls_trust.o: CFLAGS += -Wextra -Werror
$(BUILD_DIR)/lib/memory.o: CFLAGS += -fno-tree-loop-distribute-patterns
$(BUILD_DIR)/arch/armv8/task_port.o: CFLAGS += -mno-outline-atomics

all: $(BUILD_DIR)/prod/kernel8.img

.PHONY: all clean FORCE
FORCE:

$(BUILD_DIR)/build-config: FORCE tools/build_config.py
	@"$(PYTHON)" tools/build_config.py --output "$@" --cc="$(CC)" --ld="$(LD)" --objcopy="$(OBJCOPY)" --cflags="$(BUILD_CONFIG_FLAGS)" --firmware="$(WIFI_FIRMWARE_C)" --trust="$(TLS_TRUST_C)"

ifeq ($(WIFI),1)
ifneq ($(strip $(WIFI_FIRMWARE_C)),)
OBJECTS += $(BUILD_DIR)/drivers/wifi/assets.o
$(BUILD_DIR)/drivers/wifi/assets.o: $(WIFI_FIRMWARE_C)
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@
endif
endif

$(OBJECTS) $(USER_OBJECTS): $(BUILD_DIR)/build-config Makefile mk/config.mk mk/sources.mk

$(BUILD_DIR)/user/tls_trust.o: $(or $(strip $(TLS_TRUST_C)),$(TLS_TRUST_NONE))
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

# An undefined symbol here means the program reached for a kernel service.
$(BUILD_DIR)/user/terminal.elf: $(USER_OBJECTS) user/program.ld
	$(LD) -T user/program.ld $(USER_OBJECTS) -o $@

$(BUILD_DIR)/user/terminal.bin: $(BUILD_DIR)/user/terminal.elf
	$(OBJCOPY) -O binary $< $@

$(BUILD_DIR)/kernel/boot/terminal_image.o: $(BUILD_DIR)/user/terminal.bin
$(BUILD_DIR)/kernel/boot/terminal_image.o: CFLAGS += -Wa,-I$(BUILD_DIR)/user

$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/%.o: %.s
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/prod/kernel8.img: $(OBJECTS) arch/armv8/linker.ld
	$(LD) -T arch/armv8/linker.ld $(OBJECTS) -o $(BUILD_DIR)/kernel8.elf
	@mkdir -p $(dir $@)
	$(OBJCOPY) -O binary $(BUILD_DIR)/kernel8.elf $@

clean:
	rm -rf $(BUILD_DIR)

-include $(OBJECTS:.o=.d) $(USER_OBJECTS:.o=.d)

partition: all
	rm -f card-copy.img
	truncate -s 300M card-copy.img
	printf "label: dos\nstart=8192,   size=524288, type=c, bootable\nstart=532480, size=16384,  type=da\n" | sfdisk card-copy.img
	mkfs.vfat -F 32 --offset 8192 card-copy.img 262144

	mcopy -i card-copy.img@@4194304 $(BUILD_DIR)/prod/kernel8.img ::kernel8.img
	mcopy -i card-copy.img@@4194304 firmware/bcm2711-rpi-4-b.dtb ::bcm2711-rpi-4-b.dtb
	mcopy -i card-copy.img@@4194304 firmware/config.txt ::config.txt
	mcopy -i card-copy.img@@4194304 firmware/start4.elf ::start4.elf
	mcopy -i card-copy.img@@4194304 firmware/fixup4.dat ::fixup4.dat

	$(PYTHON) tools/storage_image.py format --image card-copy.img --partition 1 --confirm-format
	$(PYTHON) tools/storage_image.py inspect --image card-copy.img --partition 1