CC = aarch64-linux-gnu-gcc
LD = aarch64-linux-gnu-ld
OBJCOPY = aarch64-linux-gnu-objcopy

BUILD_DIR ?= out
.DEFAULT_GOAL := all
PYTHON ?= python
BEARSSL_DIR ?=
FIRMWARE_DIR ?= out/pi4-firmware

WIFI_COUNTRY ?=
WIFI_REGREV  ?= -1
WIFI_BLOB    ?= $(FIRMWARE_DIR)/brcmfmac43455-sdio-raspberrypi-4-model-b

ifneq ($(WIFI),0)
ifeq ($(strip $(WIFI_FIRMWARE_C)),)
ifneq ($(strip $(WIFI_COUNTRY)),)
WIFI_FIRMWARE_C := $(BUILD_DIR)/wifi/wifi-assets.c
$(WIFI_FIRMWARE_C): $(WIFI_BLOB).bin $(WIFI_BLOB).txt $(WIFI_BLOB).clm_blob tools/embed_wifi.py
	@mkdir -p $(dir $@)
	$(PYTHON) tools/embed_wifi.py --firmware "$(WIFI_BLOB).bin" --nvram "$(WIFI_BLOB).txt" \
		--clm "$(WIFI_BLOB).clm_blob" --country $(WIFI_COUNTRY) --regrev $(WIFI_REGREV) --output $@
else
$(warning WIFI_COUNTRY not set: Wi-Fi assets will not be embedded and the radio will be skipped)
endif
endif
endif

include mk/config.mk
include mk/sources.mk
include tools/bearssl-pin.mk

OBJECTS := $(patsubst %.c,$(BUILD_DIR)/%.o,$(C_SOURCES))
OBJECTS += $(patsubst %.s,$(BUILD_DIR)/%.o,$(S_SOURCES))
# The user program brings its own copy of the freestanding memory routines.
USER_OBJECTS := $(patsubst %.s,$(BUILD_DIR)/%.o,$(USER_ASM_SOURCES))
USER_OBJECTS += $(patsubst %.c,$(BUILD_DIR)/%.o,$(USER_SOURCES)) $(BUILD_DIR)/lib/memory.o
# TLS: BearSSL, and trust anchors generated by tools/fetch_ca.py (TLS_TRUST_C)
# or none. BearSSL is configured only by these flags; see docs/TLS.md.
TLS_TRUST_C ?=
BEARSSL_ROOT := $(or $(BEARSSL_DIR),out/deps/bearssl-$(BEARSSL_REVISION))
space := $(subst ,, )
BEARSSL_PREREQ_ROOT := $(subst $(space),\ ,$(BEARSSL_ROOT))
BEARSSL_OBJECTS := $(patsubst %.c,$(BUILD_DIR)/bearssl/%.o,$(BEARSSL_SOURCES))
USER_OBJECTS += $(BEARSSL_OBJECTS) $(BUILD_DIR)/user/tls_trust.o
TLS_OBJECTS := $(BEARSSL_OBJECTS) $(BUILD_DIR)/user/tls_trust.o $(BUILD_DIR)/user/lib/tls.o
BEARSSL_CPPFLAGS := -I"$(BEARSSL_ROOT)/inc" -isystem user/lib/libc -DBR_64=1 -DBR_INT128=1 \
    -DBR_USE_URANDOM=0 -DBR_USE_GETENTROPY=0 -DBR_USE_WIN32_RAND=0 -DBR_RDRAND=0 \
    -DBR_USE_UNIX_TIME=0 -DBR_USE_WIN32_TIME=0 -DBR_AES_X86NI=0 -DBR_SSE2=0 -DBR_POWER8=0

CFLAGS = -Wall -O2 -ffreestanding -nostdinc
# Firmware discovery runs with the MMU off: unaligned Device accesses can fault.
CFLAGS += -mstrict-align -MMD -MP
BUILD_CONFIG_FLAGS := $(CPPFLAGS) $(CFLAGS) $(subst ",\",$(BEARSSL_CPPFLAGS))
STRICT_SOURCES := $(MEMORY_SOURCES) $(FILESYSTEM_SOURCES) $(NETWORK_SOURCES) $(SCHEDULER_SOURCES) \
    $(DRIVER_SOURCES) platform/pi4/bluetooth.c platform/pi4/ethernet.c platform/pi4/hardware.c platform/pi4/net.c platform/pi4/startup.c \
    platform/pi4/sd.c platform/pi4/storage.c arch/armv8/task_port.c \
    arch/armv8/irq.c arch/armv8/trap.c arch/armv8/address_space.c \
    kernel/boot/main.c kernel/syscall/dispatch.c kernel/ui/render.c
$(patsubst %.c,$(BUILD_DIR)/%.o,$(STRICT_SOURCES)): CFLAGS += -Wextra -Werror
$(TLS_OBJECTS): CPPFLAGS += $(BEARSSL_CPPFLAGS)
$(BEARSSL_OBJECTS): CPPFLAGS += -I"$(BEARSSL_ROOT)/src"
$(BUILD_DIR)/user/lib/tls.o $(BUILD_DIR)/user/tls_trust.o: CFLAGS += -Wextra -Werror
$(BUILD_DIR)/lib/memory.o: CFLAGS += -fno-tree-loop-distribute-patterns
$(BUILD_DIR)/arch/armv8/task_port.o: CFLAGS += -mno-outline-atomics

all: $(BUILD_DIR)/prod/kernel8.img

.PHONY: all clean FORCE partition
FORCE:

$(BUILD_DIR)/build-config: FORCE tools/build_config.py
	@"$(PYTHON)" tools/build_config.py --output "$@" --cc="$(CC)" --ld="$(LD)" --objcopy="$(OBJCOPY)" --cflags="$(BUILD_CONFIG_FLAGS)" --firmware="$(WIFI_FIRMWARE_C)" --trust="$(TLS_TRUST_C)" --bt-patchram="$(BT_PATCHRAM)"

ifeq ($(WIFI),1)
ifneq ($(strip $(WIFI_FIRMWARE_C)),)
OBJECTS += $(BUILD_DIR)/drivers/wifi/assets.o
$(BUILD_DIR)/drivers/wifi/assets.o: $(WIFI_FIRMWARE_C)
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@
endif
endif

ifneq ($(strip $(BT_PATCHRAM)),)
OBJECTS += $(BUILD_DIR)/drivers/bluetooth/patchram.o
$(BUILD_DIR)/drivers/bluetooth/patchram.c: $(subst $(space),\ ,$(BT_PATCHRAM)) tools/bluetooth_firmware.py $(BUILD_DIR)/build-config
	@"$(PYTHON)" tools/bluetooth_firmware.py embed --input "$(BT_PATCHRAM)" --output "$@"
$(BUILD_DIR)/drivers/bluetooth/patchram.o: $(BUILD_DIR)/drivers/bluetooth/patchram.c
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@
endif

$(OBJECTS) $(USER_OBJECTS): $(BUILD_DIR)/build-config Makefile mk/config.mk mk/sources.mk

ifeq ($(BEARSSL_DIR),)
BEARSSL_STAMP := $(BEARSSL_ROOT)/.vantage-source
$(BEARSSL_STAMP): tools/bearssl-pin.mk
	@"$(PYTHON)" tools/fetch_bearssl.py
	@touch "$@"

$(TLS_OBJECTS): | $(BEARSSL_STAMP)
$(addprefix $(BEARSSL_ROOT)/src/,$(BEARSSL_SOURCES)): | $(BEARSSL_STAMP)
	@test -f "$@" || { echo 'BearSSL cache is incomplete at $(BEARSSL_ROOT)' >&2; exit 1; }
endif

$(BEARSSL_OBJECTS): $(BUILD_DIR)/bearssl/%.o: $(BEARSSL_PREREQ_ROOT)/src/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c "$(BEARSSL_ROOT)/src/$*.c" -o $@

$(BUILD_DIR)/user/tls_trust.o: $(or $(strip $(TLS_TRUST_C)),$(TLS_TRUST_NONE))
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

# An undefined symbol here means the program reached for a kernel service.
$(BUILD_DIR)/user/terminal.elf: $(USER_OBJECTS) user/program.ld
	$(LD) -T user/program.ld $(USER_OBJECTS) -o $@

$(BUILD_DIR)/user/terminal.bin: $(BUILD_DIR)/user/terminal.elf
	$(OBJCOPY) -O binary $< $@

$(BUILD_DIR)/kernel/boot/terminal_image.o: $(BUILD_DIR)/user/terminal.bin
$(BUILD_DIR)/kernel/boot/terminal_image.o: CFLAGS += -Wa,-I$(BUILD_DIR)/user

$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/%.o: %.s
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/prod/kernel8.img: $(OBJECTS) arch/armv8/linker.ld
	$(LD) -T arch/armv8/linker.ld $(OBJECTS) -o $(BUILD_DIR)/kernel8.elf
	@mkdir -p $(dir $@)
	$(OBJCOPY) -O binary $(BUILD_DIR)/kernel8.elf $@

clean:
	rm -rf $(BUILD_DIR)

-include $(OBJECTS:.o=.d) $(USER_OBJECTS:.o=.d)

partition: all
	@for file in bcm2711-rpi-4-b.dtb start4.elf fixup4.dat overlays/vc4-fkms-v3d.dtbo COPYING.linux LICENCE.broadcom; do \
		if [ ! -f "$(FIRMWARE_DIR)/$$file" ] || [ ! -r "$(FIRMWARE_DIR)/$$file" ]; then \
			echo "Missing readable $(FIRMWARE_DIR)/$$file. Set FIRMWARE_DIR to the Pi 4 boot files (see docs/STORAGE.md)." >&2; \
			exit 1; \
		fi; \
	done
	rm -f card-copy.img
	truncate -s 300M card-copy.img
	printf "label: dos\nstart=8192,   size=524288, type=c, bootable\nstart=532480, size=16384,  type=da\n" | sfdisk card-copy.img
	mkfs.vfat -F 32 --offset 8192 card-copy.img 524288

	mcopy -i card-copy.img@@4194304 $(BUILD_DIR)/prod/kernel8.img ::kernel8.img
	mcopy -i card-copy.img@@4194304 "$(FIRMWARE_DIR)/bcm2711-rpi-4-b.dtb" ::bcm2711-rpi-4-b.dtb
	mcopy -i card-copy.img@@4194304 firmware/config.txt ::config.txt
	mcopy -i card-copy.img@@4194304 "$(FIRMWARE_DIR)/start4.elf" ::start4.elf
	mcopy -i card-copy.img@@4194304 "$(FIRMWARE_DIR)/fixup4.dat" ::fixup4.dat
	mcopy -i card-copy.img@@4194304 "$(FIRMWARE_DIR)/brcmfmac43455-sdio-raspberrypi-4-model-b.clm_blob" ::brcmfmac43455-sdio-raspberrypi-4-model-b.clm_blob
	mcopy -i card-copy.img@@4194304 "$(FIRMWARE_DIR)/BCM4345C0.hcd" ::BCM4345C0.hcd
	mcopy -i card-copy.img@@4194304 "$(FIRMWARE_DIR)/brcmfmac43455-sdio-raspberrypi-4-model-b.txt" ::brcmfmac43455-sdio-raspberrypi-4-model-b.txt
	mcopy -i card-copy.img@@4194304 "$(FIRMWARE_DIR)/brcmfmac43455-sdio-raspberrypi-4-model-b.bin" ::brcmfmac43455-sdio-raspberrypi-4-model-b.bin
	mmd -i card-copy.img@@4194304 ::overlays
	mcopy -i card-copy.img@@4194304 "$(FIRMWARE_DIR)/overlays/vc4-fkms-v3d.dtbo" ::overlays/vc4-fkms-v3d.dtbo
	mcopy -i card-copy.img@@4194304 "$(FIRMWARE_DIR)/COPYING.linux" "$(FIRMWARE_DIR)/LICENCE.broadcom" ::

	$(PYTHON) tools/storage_image.py format --image card-copy.img --partition 1 --confirm-format
	$(PYTHON) tools/storage_image.py inspect --image card-copy.img --partition 1
	